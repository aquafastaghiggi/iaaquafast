# MySQL / Scanntech API
AQUAFAST_MYSQL_HOST=host.docker.internal
AQUAFAST_MYSQL_PORT=3306
AQUAFAST_MYSQL_USER=your_mysql_user
AQUAFAST_MYSQL_PASSWORD=your_mysql_password
AQUAFAST_MYSQL_DATABASE=scanntech

# Optional: copy to .env and set the values above before running docker compose.
# The Open WebUI model filter stays disabled by default. Enable it only after
# scripts/doctor_openwebui.py reports the pipe healthy.
